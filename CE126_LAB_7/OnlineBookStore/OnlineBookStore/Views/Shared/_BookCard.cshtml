@model OnlineBookStore.Models.Book

<div class="col-md-4 mb-4">

    <div class="card h-100 shadow">

        <div class="card-body">

            <h5 class="card-title">
                @Model.Title
            </h5>

            <p class="card-text">
                <strong>Author:</strong> @Model.Author
            </p>

            <p class="card-text">
                <strong>Category:</strong> @Model.Category
            </p>

            <p class="card-text">
                @Model.Description
            </p>

            <h5 class="text-success">
                ₹@Model.Price
            </h5>

            <a asp-controller="Books"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                View Details
            </a>

        </div>

    </div>

</div>