@model ProductOrderManagement.Models.OrderViewModel

@{
    ViewData["Title"] = "Order Successful";
}

<div class="card shadow">

    <div class="card-body">

        <h1 class="text-success">
            Order Placed Successfully!
        </h1>

        <hr />

        <h4>Customer Details</h4>

        <p>
            <strong>Name:</strong>
            @Model.CustomerName
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Phone:</strong>
            @Model.Phone
        </p>


        <h4 class="mt-4">
            Order Details
        </h4>

        <p>
            <strong>Product:</strong>
            @ViewBag.ProductName
        </p>

        <p>
            <strong>Price:</strong>
            ₹@ViewBag.Price
        </p>

        <p>
            <strong>Quantity:</strong>
            @Model.Quantity
        </p>

        <p>
            <strong>Total Amount:</strong>
            ₹@ViewBag.TotalAmount
        </p>


        <h4 class="mt-4">
            Delivery Information
        </h4>

        <p>
            <strong>Address:</strong>
            @Model.DeliveryAddress
        </p>

        <p>
            <strong>City:</strong>
            @Model.City
        </p>

        <p>
            <strong>Pincode:</strong>
            @Model.Pincode
        </p>


        <a asp-controller="Order"
           asp-action="Create"
           class="btn btn-primary">
            Place Another Order
        </a>

    </div>

</div>