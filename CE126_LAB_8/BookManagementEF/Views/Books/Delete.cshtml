
@model BookManagementEF.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<h3>Are you sure you want to delete this book?</h3>

<div class="alert alert-danger">
    This book will be permanently deleted.
</div>

<dl class="row">

    <dt class="col-sm-3">
        Book ID
    </dt>

    <dd class="col-sm-9">
        @Model.BookId
    </dd>

    <dt class="col-sm-3">
        Title
    </dt>

    <dd class="col-sm-9">
        @Model.Title
    </dd>

    <dt class="col-sm-3">
        Author
    </dt>

    <dd class="col-sm-9">
        @Model.Author
    </dd>

    <dt class="col-sm-3">
        Category
    </dt>

    <dd class="col-sm-9">
        @Model.Category
    </dd>

    <dt class="col-sm-3">
        Price
    </dt>

    <dd class="col-sm-9">
        ₹ @Model.Price
    </dd>

    <dt class="col-sm-3">
        Published Year
    </dt>

    <dd class="col-sm-9">
        @Model.PublishedYear
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="BookId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
