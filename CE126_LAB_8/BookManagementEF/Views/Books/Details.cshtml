
@model BookManagementEF.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Book ID
            </dt>

            <dd class="col-sm-9">
                @Model.BookId
            </dd>

            <dt class="col-sm-3">
                Title
            </dt>

            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <dt class="col-sm-3">
                Author
            </dt>

            <dd class="col-sm-9">
                @Model.Author
            </dd>

            <dt class="col-sm-3">
                Category
            </dt>

            <dd class="col-sm-9">
                @Model.Category
            </dd>

            <dt class="col-sm-3">
                Price
            </dt>

            <dd class="col-sm-9">
                ₹ @Model.Price
            </dd>

            <dt class="col-sm-3">
                Published Year
            </dt>

            <dd class="col-sm-9">
                @Model.PublishedYear
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.BookId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>
</div>
