@page
@model RazorPages_Session.Pages.User.ResultModel

<div class="form-container">

    <h2>✅ User Details</h2>

    <p><b>Name:</b> @Model.Name</p>
    <p><b>Email:</b> @Model.Email</p>
    <p><b>Contact:</b> @Model.ContactNo</p>
    <p><b>Gender:</b> @Model.Gender</p>

    <a asp-page="/User">← Back</a>

</div>