@model MVC_BookApp_Repo.Models.Book

<div class="container">

    <div class="form-box">
        <h2>📖 Book Details</h2>

        <div class="form-group">
            <label>ID</label>
            <input value="@Model.BookId" readonly />
        </div>

        <div class="form-group">
            <label>Title</label>
            <input value="@Model.Title" readonly />
        </div>

        <div class="form-group">
            <label>Author</label>
            <input value="@Model.Author" readonly />
        </div>

        <div class="form-group">
            <label>Category</label>
            <input value="@Model.Category" readonly />
        </div>

        <div class="form-group">
            <label>Price</label>
            <input value="@Model.Price" readonly />
        </div>

        <div class="form-group">
            <label>Published Year</label>
            <input value="@Model.PublishedYear" readonly />
        </div>

        <a asp-action="Index" class="back-link">← Back</a>
    </div>

</div>