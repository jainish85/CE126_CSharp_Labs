@model List<MVC_BookApp.Models.Book>

<div class="page-container">

    <div class="header">
        <div class="title">📚 Book Management</div>
        <a asp-action="Create" class="add-btn">+ Add Book</a>
    </div>

    <table class="book-table">

        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Actions</th>
        </tr>

        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BookId</td>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td>
                    <a asp-action="Details" asp-route-id="@b.BookId" class="btn details">Details</a>
                    <a asp-action="Edit" asp-route-id="@b.BookId" class="btn edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@b.BookId" class="btn delete">Delete</a>
                </td>
            </tr>
        }

    </table>

</div>