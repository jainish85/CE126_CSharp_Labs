@model MVC_BookApp.Models.Book

<div class="form-box">

    <h2>📚 Add Book</h2>

    <form asp-action="Create" method="post">

        <label>Title</label>
        <input asp-for="Title" />

        <label>Author</label>
        <input asp-for="Author" />

        <label>Category</label>
        <input asp-for="Category" />

        <label>Price</label>
        <input asp-for="Price" />

        <label>Published Year</label>
        <input asp-for="PublishedYear" />

        <br />
        <button type="submit">➕ Add Book</button>

    </form>

</div>

<a asp-action="Index">← Back</a>